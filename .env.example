# Database Configuration
# Options: sqlite | postgres | both
DB_BACKEND=sqlite

# PostgreSQL Connection (used when DB_BACKEND=postgres or both)
PG_HOST=localhost
PG_PORT=5432
PG_DB=workforce_dw
PG_USER=analytics_user
PG_PASSWORD=your_secure_local_password
PG_SCHEMA=dw

# Local SQLite Warehouse Path
SQLITE_DB_PATH=data/warehouse/workforce_dw.db

# Dataset Generation Defaults
NUM_EMPLOYEES=25000
RANDOM_SEED=42
AS_OF_DATE=2026-09-30
CURRENCY=INR

