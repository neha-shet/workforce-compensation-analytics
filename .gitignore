data/raw/*.csv
data/raw/*.xlsx
data/quarantine/*.csv
data/processed/*.parquet
data/processed/*.csv
data/processed/warehouse/*.csv
data/processed/warehouse/*.parquet
data/warehouse/*.db
data/warehouse/*.sqlite

# Runtime JSON & SQL CSV caches (Markdown reports, PNG figures & 350 KB champion ML artifacts stay tracked)
reports/*.json
reports/sql_results/*.csv

